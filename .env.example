# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local (it is already in .gitignore).

# Secret used to sign session cookies (at least 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" only when the site is served over HTTPS.
# The first EC2 deployment uses plain HTTP, so keep it "false" for now.
COOKIE_SECURE=false

# --- Used later (not needed yet) ---
# AWS_REGION=ap-southeast-1
# S3_BUCKET=labfix-photos-yourname
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_USER=labfix_app
# DB_PASSWORD=
# DB_NAME=labfix
